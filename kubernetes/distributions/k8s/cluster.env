#!/usr/bin/env bash

# Cluster-wide pinned versions
export K8S_VERSION="1.34.6"
export CONTAINERD_VERSION="2.1.7"
export CILIUM_VERSION="v1.19.3"
export CILIUM_CLI_VERSION="v0.18.9"
export KUBE_VIP_VERSION="v1.1.2"
export RUNC_VERSION="1.4.2"
export CNI_PLUGIN_VERSION="1.9.1"

# Control-plane endpoint (kube-vip owned)
export CONTROL_PLANE_ENDPOINT="192.168.0.220:6443"
export CONTROL_PLANE_VIP="192.168.0.220"
export CONTROL_PLANE_VIP_IFACE="eno1"
export CONTROL_PLANE_HA_MODE="keepalived_haproxy"  # values: kube-vip | keepalived_haproxy

# Cilium install mode
export CILIUM_ENABLE_HUBBLE="true"
export CILIUM_IPV4_NATIVE_ROUTING_CIDR="192.168.0.0/24"

# Node inventory and bootstrap order
export PRIMARY_CONTROL_PLANE="server4"
export CONTROL_PLANE_NODES=("server4" "server3" "server2")
export WORKER_NODES=("server1")
export ALL_NODES=("server1" "server2" "server3" "server4")

# Node addresses
export SERVER1_IP="192.168.0.221"
export SERVER2_IP="192.168.0.222"
export SERVER3_IP="192.168.0.223"
export SERVER4_IP="192.168.0.224"

# SSH map from current machine
export SSH_BASTION_IP="<REDACTED>"
export SERVER1_USER="server1"
export SERVER2_USER="server2"
export SERVER3_USER="server3"
export SERVER4_USER="server4"
export SERVER1_PORT="22001"
export SERVER2_PORT="22002"
export SERVER3_PORT="22003"
export SERVER4_PORT="22004"

# Local directory for generated artifacts
export K8S_WORKDIR="${K8S_WORKDIR:-$HOME/k8s}"
